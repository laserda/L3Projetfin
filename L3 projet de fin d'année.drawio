  <diagram id="9diNsrOCKCJJzx-DLHdT" name="Diagramme de Classes">
    <mxGraphModel dx="2253" dy="1946" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nentity \&quot;Citoyen\&quot; {\n  +ID_Citoyen : UUID\n  Nom : String\n  Prenom : String\n  Date_Naissance : Date\n  Lieu_Naissance : String\n  Adresse : String\n  Email : String\n  Telephone : String\n}\n\nentity \&quot;Demande\&quot; {\n  +ID_Demande : UUID\n  ID_Citoyen : UUID\n  Type_Acte : Enum [Naissance, Mariage, Décès]\n  Statut : Enum [Soumise, En traitement, Validée, Refusée, Livrée]\n  Date_Demande : DateTime\n  ID_Paiement : UUID\n}\n\nentity \&quot;Document_Acte\&quot; {\n  +ID_Acte : UUID\n  ID_Demande : UUID\n  Date_Delivrance : DateTime\n  Fichier_PDF : Lien\n  Signature_Numerique : String\n  Est_Archive : Boolean\n  Date_Archivage : DateTime\n}\n\nentity \&quot;Paiement\&quot; {\n  +ID_Paiement : UUID\n  Montant : Decimal\n  Mode_Paiement : Enum [Mobile_Money, Carte_Bancaire, Virement]\n  Date_Paiement : DateTime\n  Transaction_ID : String\n}\n\nentity \&quot;Agent\&quot; {\n  +ID_Agent : UUID\n  Nom : String\n  Prenom : String\n  Email : String\n  Role : Enum [Agent, Administrateur]\n}\n\nentity \&quot;Historique_Modifications\&quot; {\n  +ID_Historique : UUID\n  Type_Entite : Enum [Demande, Acte]\n  ID_Entite : UUID\n  ID_Agent : UUID\n  Action : String\n  Date_Modification : DateTime\n  Ancienne_Valeur : Text\n  Nouvelle_Valeur : Text\n}\nCitoyen \&quot;1\&quot; -- \&quot;0..*\&quot; Demande : fait\nDemande \&quot;1\&quot; -- \&quot;1\&quot; Document_Acte : produit\nDemande \&quot;1\&quot; -- \&quot;1\&quot; Paiement : payé_par\nAgent \&quot;1\&quot; -- \&quot;0..*\&quot; Historique_Modifications : enregistre\nHistorique_Modifications \&quot;0..*\&quot; -- \&quot;1\&quot; Demande : concerne\nHistorique_Modifications \&quot;0..*\&quot; -- \&quot;1\&quot; Document_Acte : concerne\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="4FE7bUXn4mwZ9wUi8sG4-1">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" parent="1" vertex="1">
            <mxGeometry x="1930" y="-1130" width="726" height="820" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nentity \&quot;Citoyen\&quot; {\n  +ID_Citoyen : UUID\n  Nom : String\n  Prenom : String\n  Date_Naissance : Date\n  Lieu_Naissance : String\n  Adresse : String\n  Email : String\n  Telephone : String\n}\n\nentity \&quot;Demande\&quot; {\n  +ID_Demande : UUID\n  ID_Citoyen : UUID\n  Type_Acte : Enum [Naissance, Mariage, Décès]\n  Statut : Enum [Soumise, En traitement, Validée, Refusée, Livrée]\n  Date_Demande : DateTime\n  ID_Paiement : UUID\n}\n\nentity \&quot;Document_Acte\&quot; {\n  +ID_Acte : UUID\n  ID_Demande : UUID\n  Date_Delivrance : DateTime\n  Fichier_PDF : Lien (Ne pas stocker le PDF)\n  Signature_Numerique : String\n  Est_Archive : Boolean\n  Date_Archivage : DateTime\n}\n\nentity \&quot;Paiement\&quot; {\n  +ID_Paiement : UUID\n  Montant : Decimal\n  Mode_Paiement : Enum [Mobile_Money, Carte_Bancaire, Virement]\n  Date_Paiement : DateTime\n  Transaction_ID : String\n}\n\nentity \&quot;Agent\&quot; {\n  +ID_Agent : UUID\n  Nom : String\n  Prenom : String\n  Email : String\n  Role : Enum [Agent, Administrateur]\n}\n\nentity \&quot;Historique_Modifications\&quot; {\n  +ID_Historique : UUID\n  Type_Entite : Enum [Demande, Acte]\n  ID_Entite : UUID\n  ID_Agent : UUID\n  Action : String\n  Date_Modification : DateTime\n  Ancienne_Valeur : Text\n  Nouvelle_Valeur : Text\n}\n\nCitoyen ||--o{ Demande : fait\nDemande ||--|| Document_Acte : génère\nDemande ||--|| Paiement : associé\nAgent ||--o{ Document_Acte : valide\nAgent ||--o{ Historique_Modifications : modifie\nHistorique_Modifications }o--|| Demande : concerne\nHistorique_Modifications }o--|| Document_Acte : concerne\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="dy7gHBvt2ktkr1UPaqxy-1">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" parent="1" vertex="1">
            <mxGeometry x="1030" y="-750" width="819" height="820" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nskinparam classAttributeIconSize 0\n\nenum TypeActe {\n  Naissance\n  Mariage\n  Décès\n}\n\nenum DemandePourTier {\n  Moi\n  MonEnfant\n  UnMenbreFamile\n  Autre\n}\n\nenum StatutDemande {\n  SoumiseEnAttenteDePaiment\n  SoumisePayee\n  EnTraitement\n  Validée\n  Refusée\n  Livrée\n}\n\nenum ModePaiement {\n  Mobile_Money\n  Carte_Bancaire\n  Virement\n}\n\nenum RoleAgent {\n  Agent\n  Administrateur\n}\n\nenum TypeEntite {\n  Demande\n  Acte\n}\n\nclass Citoyen {\n  ID_Citoyen: String\n  Nom: String\n  Prenom: String\n  DateNaissance: DateTime\n  LieuNaissance: String\n  Adresse: String\n  Email: String\n  Telephone: String\n  Password: String\n}\n\nclass Demande {\n  ID_Demande: String\n  ID_Citoyen: String\n  TypeActe: TypeActe\n  NumeroActe: String\n  Nom: String\n  Prenom: String\n  Statut: StatutDemande\n  DemandePourTier: DemandePourTier\n  DateDemande: DateTime\n  DateActe: DateTime?\n  ID_Paiement: String?\n}\n\nclass Document_Acte {\n  ID_Document_Acte: String\n  ID_Demande: String\n  ID_Agent: String\n  DateDelivrance: DateTime\n  Fichier_PDF: String\n  SignatureNumerique: String\n  EstArchive: Boolean\n  DateArchivage: DateTime\n}\n\nclass Paiement {\n  ID_Paiement: String\n  Montant: Decimal\n  ModePaiement: ModePaiement\n  DatePaiement: DateTime\n  Transaction_ID: String\n}\n\nclass Agent {\n  ID_Agent: String\n  Nom: String\n  Prenom: String\n  Email: String\n  Role: RoleAgent\n  Password: String\n}\n\nclass Historique_Modifications {\n  ID_Historique: String\n  TypeEntite: TypeEntite\n  ID_Demande: String?\n  ID_Agent: String\n  Action: String\n  DateModification: DateTime\n  Ancienne_Valeur: String\n  Nouvelle_Valeur: String\n}\n\nclass FraisTimbre {\n  ID_FraisTimbre: Int\n  TypeActe: TypeActe\n  PrixTimbre: Float\n  FraisDossier: Float?\n  CreatedAt: DateTime\n  UpdatedAt: DateTime\n}\n\nclass Mariage {\n  ID_Mariage: String\n}\n\nclass Naissance{\n  ID_Naissance: String\n}\n\nclass Deces {\n  ID_Deces: String\n}\n\nCitoyen \&quot;1\&quot; -- \&quot;0..*\&quot; Demande\nDemande \&quot;1\&quot; -- \&quot;0..1\&quot; Paiement\nDemande \&quot;1\&quot; -- \&quot;0..1\&quot; Document_Acte\nAgent \&quot;1\&quot; -- \&quot;0..*\&quot; Document_Acte\nDemande \&quot;1\&quot; -- \&quot;0..*\&quot; Mariage \nDemande \&quot;1\&quot; -- \&quot;0..*\&quot; Naissance\nDemande \&quot;1\&quot; -- \&quot;0..*\&quot; Deces \n\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="mC7042BEtPPBkm9UNAbL-1">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" parent="1" vertex="1">
            <mxGeometry x="-760" y="-900" width="1396" height="697" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
