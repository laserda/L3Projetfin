            <mxGeometry x="20" y="1090" width="669" height="793" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nactor Citoyen\nparticipant Frontend\nparticipant Backend\nparticipant BaseDeDonnées\nparticipant PaiementAPI\nparticipant PDFService\n\nCitoyen -&gt; Frontend : Inscription\nFrontend -&gt; Backend : POST /auth/register\nBackend -&gt; BaseDeDonnées : Créer nouveau citoyen\nBaseDeDonnées --&gt; Backend : Succès\nBackend --&gt; Frontend : Compte créé\nFrontend --&gt; Citoyen : Message de confirmation\n\nCitoyen -&gt; Frontend : Connexion\nFrontend -&gt; Backend : POST /auth/login\nBackend -&gt; BaseDeDonnées : Vérifie identifiants\nBaseDeDonnées --&gt; Backend : OK + rôle\nBackend --&gt; Frontend : Token JWT\nFrontend --&gt; Citoyen : Accès espace personnel\n\nCitoyen -&gt; Frontend : Remplir formulaire de demande\nFrontend -&gt; Backend : POST /demandes\nBackend -&gt; BaseDeDonnées : Enregistrer demande\nBaseDeDonnées --&gt; Backend : ID de demande\nBackend --&gt; Frontend : Demande enregistrée\n\nCitoyen -&gt; Frontend : Paiement en ligne\nFrontend -&gt; Backend : POST /paiements\nBackend -&gt; PaiementAPI : Initier transaction\nPaiementAPI --&gt; Backend : URL de paiement\nBackend --&gt; Frontend : Rediriger vers paiement\nCitoyen -&gt; PaiementAPI : Paiement effectué\n\nPaiementAPI -&gt; Backend : Notification succès paiement\nBackend -&gt; BaseDeDonnées : Marquer demande comme payée\nBackend -&gt; PDFService : Générer PDF signé\nPDFService --&gt; Backend : Lien fichier PDF\nBackend -&gt; BaseDeDonnées : Sauvegarder acte\nBackend -&gt; Citoyen : Notification PDF disponible\n\nCitoyen -&gt; Frontend : Télécharger mon acte\nFrontend -&gt; Backend : GET /actes/{id}/telecharger\nBackend -&gt; BaseDeDonnées : Lire fichier PDF\nBackend --&gt; Frontend : Retourne PDF\nFrontend --&gt; Citoyen : Téléchargement fichier\n\nCitoyen -&gt; Frontend : Voir l’historique\nFrontend -&gt; Backend : GET /demandes/historique\nBackend -&gt; BaseDeDonnées : Requête demandes\nBackend --&gt; Frontend : Liste demandes\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="0BFK-vCzuuTGOX4ENMAa-1">
