          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nactor Admin\nparticipant Frontend\nparticipant Backend\nparticipant BaseDeDonnées\n\nAdmin -&gt; Frontend : Connexion\nFrontend -&gt; Backend : POST /auth/login\nBackend -&gt; BaseDeDonnées : Vérifie Admin\nBaseDeDonnées --&gt; Backend : Auth OK\nBackend --&gt; Frontend : Token JWT\nFrontend --&gt; Admin : Accès interface admin\n\nAdmin -&gt; Frontend : Gérer un agent\nFrontend -&gt; Backend : POST /agents\nBackend -&gt; BaseDeDonnées : Créer nouvel agent\nBackend --&gt; Frontend : Succès\n\nAdmin -&gt; Frontend : Modifier frais de timbre\nFrontend -&gt; Backend : PUT /configuration/timbres\nBackend -&gt; BaseDeDonnées : Mettre à jour table config\nBackend --&gt; Frontend : Mis à jour OK\n\nAdmin -&gt; Frontend : Voir logs / historique\nFrontend -&gt; Backend : GET /historique\nBackend -&gt; BaseDeDonnées : Requêter logs d’actions\nBackend --&gt; Frontend : Afficher tableau des logs\n\nAdmin -&gt; Frontend : Voir dashboard global\nFrontend -&gt; Backend : GET /dashboard\nBackend -&gt; BaseDeDonnées : Agréger stats toutes communes\nBackend --&gt; Frontend : Affiche tableau global\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="JJmbvtvG89R8DlhTuuRO-2">
