        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nactor Agent\nparticipant Frontend\nparticipant Backend\nparticipant BaseDeDonnées\nparticipant PDFService\n\nAgent -&gt; Frontend : Connexion\nFrontend -&gt; Backend : POST /auth/login\nBackend -&gt; BaseDeDonnées : Vérifie Agent + rôle\nBaseDeDonnées --&gt; Backend : Auth OK\nBackend --&gt; Frontend : Token JWT\nFrontend --&gt; Agent : Accès interface agent\n\nAgent -&gt; Frontend : Ouvrir tableau des demandes\nFrontend -&gt; Backend : GET /demandes/pending\nBackend -&gt; BaseDeDonnées : Lire demandes en attente\nBaseDeDonnées --&gt; Backend : Liste demandes\nBackend --&gt; Frontend : Affiche tableau\n\nAgent -&gt; Frontend : Valider une demande\nFrontend -&gt; Backend : PUT /demandes/{id}/decision\nBackend -&gt; BaseDeDonnées : Mettre à jour statut (Validée)\nBackend -&gt; PDFService : Générer PDF signé\nPDFService --&gt; Backend : PDF + Signature\nBackend -&gt; BaseDeDonnées : Enregistrer Acte signé\nBackend --&gt; Frontend : Succès\nFrontend --&gt; Agent : Notification succès\n\nAgent -&gt; Frontend : Archiver un acte\nFrontend -&gt; Backend : PUT /actes/{id}/archiver\nBackend -&gt; BaseDeDonnées : Mise à jour estArchive = true\nBackend --&gt; Frontend : Archivé OK\n\nAgent -&gt; Frontend : Voir statistiques\nFrontend -&gt; Backend : GET /statistiques\nBackend -&gt; BaseDeDonnées : Agréger données\nBackend --&gt; Frontend : Graphes et chiffres\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="JJmbvtvG89R8DlhTuuRO-1">
