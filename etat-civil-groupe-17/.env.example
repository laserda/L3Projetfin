# Base de données PostgreSQL
# Format : postgresql://UTILISATEUR:MOTDEPASSE@HOTE:PORT/BASE?schema=public
# Caractères spéciaux du mot de passe à encoder : @ -> %40, : -> %3A, / -> %2F, # -> %23, ? -> %3F, % -> %25
DATABASE_URL="postgresql://utilisateur:motdepasse@localhost:5432/etat_civil_bd?schema=public"

# Secrets de signature des sessions (JWT) — une valeur longue et aléatoire différente pour chacun
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CITOYEN_SESSION_SECRET="a_remplacer"
ADMIN_SESSION_SECRET="a_remplacer"

# Clé publique Paystack (pk_test_... en développement, pk_live_... en production)
# Injectée au moment du build : reconstruire l'image après modification
NEXT_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# pgAdmin (docker-compose)
PGADMIN_DEFAULT_EMAIL="admin@example.com"
PGADMIN_DEFAULT_PASSWORD="a_remplacer"
